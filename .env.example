# Every environment variable the app, its tooling and its tests read.
# Copy to .env.local for local development. Never commit real values.

# Postgres connection used by `npm run db:migrate` and drizzle-kit.
DATABASE_URL=postgres://postgres:pg@127.0.0.1:5432/postgres

# Disposable Postgres for integration tests. Unset locally = integration tests are skipped;
# CI must set it.
TEST_DATABASE_URL=

# Commit SHA reported by /api/health (defaults to "dev").
BUILD_SHA=

# Next build output directory (default .next). Use a separate one per concurrent build.
NEXT_DIST_DIR=

# Port for the Playwright web server (default 3100).
E2E_PORT=

# Set by CI runners; makes Playwright start without a local build and forbids test.only.
CI=

# Server core (src/server/config/env.ts). Required in production; local defaults otherwise.
# Origin the app is served from (cookies, WebAuthn and Origin checks bind to it).
APP_ORIGIN=
# Canonical public origin for links in emails.
CANONICAL_ORIGIN=
# The three hosts of the one app (src/server/config/hosts.ts): public, client and staff.
# Unset locally: http://localhost:<port>, http://my.localhost:<port>, http://app.localhost:<port>.
# Pages answer only on these hosts; any other host (127.0.0.1 too) gets only /api/health.
PUBLIC_ORIGIN=
CLIENT_ORIGIN=
STAFF_ORIGIN=
# 32+ character secret for keyed hashes of rate-limit identifiers.
AUTH_SECRET=
# Gateway-to-origin transport authentication, separate from user identity. Required for real
# production hosts. During rotation accept the old secret briefly, then remove it.
ORIGIN_VERIFY_SECRET=
ORIGIN_VERIFY_PREVIOUS_SECRET=
# Docker build enables standalone Next output; not required for next start/browser tests.
BUILD_STANDALONE=
# Bundled migrator sets this to /app/db/migrations; source CLI uses the repository directory.
MIGRATIONS_FOLDER=
# WebAuthn relying-party display name. Each private host is its own relying party: the staff
# passkeys belong to the STAFF_ORIGIN host, client passkeys to the CLIENT_ORIGIN host.
WEBAUTHN_RP_NAME=
# "1" delivers email in-process to a capture readable at /api/test-outbox (e2e, local work).
# Ignored unless all three origins are localhost / *.localhost names.
ENABLE_TEST_OUTBOX=

# Explicit Resend auth-template delivery. No real mail is sent until configured.
EMAIL_FROM=
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Staging parity notice only; durable inquiry intent stays pending until explicitly enabled.
# The single inbox must be operator-reviewed and equal the staging Email binding allowlist.
INQUIRY_COVERAGE_NOTICE_ENABLED=0
INQUIRY_COVERAGE_TEST_INBOX_REVIEWED=false
INQUIRY_COVERAGE_TEST_INBOX=
# Optional Better Stack queue-job heartbeat, after actual queue processing succeeds.
WORKER_HEARTBEAT_URL=

# Sealed files: local is allowed only on loopback hosts, with an absolute root.
# Use r2 in a deployed environment. ClamAV must have fresh signatures; unavailable scan blocks review.
FILE_STORAGE=
FILE_STORAGE_ROOT=
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_MAX_SIGNATURE_AGE_HOURS=

# R2 media access; all four or none.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Base URL public media renditions are served from, e.g. https://makler-realty.com/media.
# Required in production; unset elsewhere means media has no public URL and is not shown.
MEDIA_PUBLIC_BASE_URL=

# Exact candidate identity used by /api/ops/readiness. Missing or stale evidence blocks it.
# Values come from the approved deployment manifest, never from an arbitrary uploaded report.
RELEASE_ENVIRONMENT=
RELEASE_MANIFEST_DIGEST=
RELEASE_POLICY_DIGEST=
RELEASE_SNAPSHOT_DIGEST=

# Optional public map; same SHA-256 asset release as the gateway MAP_RELEASE_ID.
# Enable only after the public-only R2 atlas/glyph/sprite release is verified.
MAP_RELEASE_ID=

# Human-reviewed Case email stays disabled until sender/reply-domain qualification.
CASE_EMAIL_ENABLED=
CASE_REPLY_DOMAIN=

# Fetch signed inbound-email receipts into private staff triage. Disabled by default.
# Human-selected attachment imports also require this flag, MAIL_PROVIDER=resend,
# RESEND_API_KEY, private file storage and the files.process worker/ClamAV.
CASE_INBOUND_ENABLED=0

# Hermes routing is disabled until source processing and the restricted key are qualified.
# Policy schema and live qualification requirements: src/server/ai/README.md
HERMES_ENABLED=0
HERMES_PROVIDER=openrouter
HERMES_PROCESSING_APPROVED=0
HERMES_ROUTING_QUALIFIED=0
HERMES_ROUTING_POLICY=
OPENROUTER_API_KEY=
HERMES_INPUT_USD_MICROS_PER_TOKEN=
HERMES_OUTPUT_USD_MICROS_PER_TOKEN=
HERMES_DAILY_LIMIT_USD_MICROS=
# Optional typed draft assessment; independent model/snapshot and cost qualification.
HERMES_JEV_ENABLED=0
HERMES_JEV_QUALIFIED=0
HERMES_JEV_POLICY=

# Zero-loss launch public crawl policy. Set exactly true on protected staging only.
STAGING=false
# Nonsecret legacy IDs observed in the live WordPress response; controller baseline
# and consent/runtime qualification remain required. No replacement ID is invented.
GTM_CONTAINER_ID=GTM-MSJ9W89
SITE_GOOGLE_VERIFICATION=BX5m2oluMQEljnLveO4e85ujRSPI7Z-CMgAk1ZDLMMU
# The legacy source also contains UA-50966114-2 (retired Universal Analytics).
# Preserve this provenance; do not claim it is a functioning GA4 destination.
