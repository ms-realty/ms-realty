# Every environment variable the app, its tooling and its tests read.
# Copy to .env.local for local development. Never commit real values.

# Postgres connection used by `npm run db:migrate` and drizzle-kit.
DATABASE_URL=postgres://postgres:pg@127.0.0.1:5432/postgres

# Disposable Postgres for integration tests. Unset locally = integration tests are skipped;
# CI must set it.
TEST_DATABASE_URL=

# Commit SHA reported by /api/health (defaults to "dev").
BUILD_SHA=

# Next build output directory (default .next). Use a separate one per concurrent build.
NEXT_DIST_DIR=

# Port for the Playwright web server (default 3100).
E2E_PORT=

# Set by CI runners; makes Playwright start without a local build and forbids test.only.
CI=
