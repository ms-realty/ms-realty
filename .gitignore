.DS_Store
node_modules/
.next*/
next-env.d.ts
*.tsbuildinfo
coverage/
test-results/
playwright-report/
.env*
!.env.example

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Machine-local runtime state the legacy app left in existing checkouts. The legacy
# code is gone (tag legacy-app-final); these must never be committed.
/production/
# Preserve only the two owner-designated launch-authority inputs from the legacy checkout.
!/production/
/production/*
!/production/data/
/production/data/*
!/production/data/launch-readiness.json
!/production/data/launch-input-checklist.md
/migration/
/search/
__pycache__/

# Release readiness views are generated per release by `npm run release:evaluate`.
/release/readiness.json
/release/readiness.md

# Storybook build output (npm run storybook:build).
/storybook-static/
/dist-runtime/
/deploy/*.generated.json
