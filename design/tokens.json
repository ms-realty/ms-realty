{
  "$description": "MS Realty design tokens: the single source for src/ui/tokens.css and design/figma-variables.json (npm run tokens:build). W3C Design Tokens Format Module 2025.10. Palette, type, spacing and breakpoints follow docs/architecture.md §11.3 and docs/ux-spec.md §06. Components use the semantic roles only; src/ui/tokens.test.ts checks every contrast pair in use.",
  "color": {
    "$type": "color",
    "canvas": {
      "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9686, 0.9529], "hex": "#f8f7f3" },
      "$description": "Page background (§11.3)."
    },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
      "$description": "Cards, panels, header and controls (§11.3)."
    },
    "subtle": {
      "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9451, 0.9255], "hex": "#eef1ec" },
      "$description": "Quiet fills: hover, placeholders, staff navigation rail."
    },
    "ink": {
      "$value": "{color.text}",
      "$description": "Inverse band for tooltips only. Focusable content on it uses focus-inverse."
    },
    "text": {
      "$value": { "colorSpace": "srgb", "components": [0.098, 0.1804, 0.1529], "hex": "#192e27" },
      "$description": "Primary text: essential facts (§11.3)."
    },
    "text-muted": {
      "$value": { "colorSpace": "srgb", "components": [0.3216, 0.3843, 0.3529], "hex": "#52625a" },
      "$description": "Secondary text: supporting context, never required data (§11.3)."
    },
    "text-inverse": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
      "$description": "Text on the primary action and on ink (§11.3)."
    },
    "text-on-ink-muted": {
      "$value": { "colorSpace": "srgb", "components": [0.7216, 0.7725, 0.7412], "hex": "#b8c5bd" },
      "$description": "Secondary text on ink."
    },
    "divider": {
      "$value": { "colorSpace": "srgb", "components": [0.851, 0.8745, 0.8471], "hex": "#d9dfd8" },
      "$description": "Subtle border: separates content only, never the sole control or focus boundary (§11.3)."
    },
    "border": {
      "$value": { "colorSpace": "srgb", "components": [0.4078, 0.4784, 0.4353], "hex": "#687a6f" },
      "$description": "Interactive outline: bounds inputs and controls at 3:1 or better (ux-spec §06.1)."
    },
    "focus": {
      "$value": { "colorSpace": "srgb", "components": [0.0902, 0.3059, 0.651], "hex": "#174ea6" },
      "$description": "Focus indicator, independent of the palette (§11.3, ux-spec §06.1)."
    },
    "focus-inverse": {
      "$value": "{color.text-inverse}",
      "$description": "Focus indicator on ink."
    },
    "on-action": {
      "$value": "{color.text-inverse}",
      "$description": "Text and icons on the primary action surface."
    },
    "brand": {
      "$value": "{color.action}",
      "$description": "Agency identity; in palette B the same green as the primary action (owner decision 2026-10-02)."
    },
    "brand-tint": {
      "$value": "{color.selected}",
      "$description": "Agency supporting surface; same tint as a selected item."
    },
    "accent": {
      "$value": "{color.brand}",
      "$description": "Inline workflow links that read as the agency colour."
    },
    "rule": {
      "$value": "{color.divider}",
      "$description": "Hairline separators between list entries."
    },
    "action": {
      "$value": { "colorSpace": "srgb", "components": [0.1294, 0.3098, 0.2353], "hex": "#214f3c" },
