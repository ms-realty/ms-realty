    "assist-soft": {
      "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9294, 0.9765], "hex": "#f1edf9" }
    },
    "assist-line": {
      "$value": "{color.assist}"
    },
    "overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.098, 0.1804, 0.1529],
        "alpha": 0.5,
        "hex": "#192e27"
      },
      "$description": "Scrim behind modal sheets and dialogs."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Noto Sans",
          "Noto Sans Hebrew",
          "Noto Sans Fallback",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Self-hosted Noto Sans (latin, latin-ext, cyrillic, greek) with Noto Sans Hebrew (§11.3). Hebrew pages put Noto Sans Hebrew first (src/ui/base.css)."
      },
      "display": {
        "$value": [
          "Noto Sans",
          "Noto Sans Hebrew",
          "Noto Sans Fallback",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Titles use Noto Sans like the body: owner decision 2026-10-02 (palette B, architecture §11.3), no Manrope."
      }
