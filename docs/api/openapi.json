                        },
                        "purpose": {
                          "type": "string",
                          "enum": [
                            "question",
                            "callback",
                            "viewing_request",
                            "seller_consultation",
                            "landlord_consultation",
                            "service_consultation"
                          ]
                        },
                        "locale": {
                          "type": "string",
                          "enum": ["bg", "en", "ru", "de", "nl", "el", "he"]
                        },
                        "listingReference": {
                          "type": ["string", "null"]
                        }
                      },
                      "required": [
                        "receiptId",
                        "status",
                        "reference",
                        "acceptedAt",
                        "purpose",
                        "locale",
                        "listingReference"
                      ],
                      "additionalProperties": false
                    },
                    "operationId": {
                      "type": "string"
                    }
                  },
                  "required": ["receipt", "operationId"],
                  "additionalProperties": false
                },
                "example": {
                  "receipt": {
                    "receiptId": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA.00000000000000000000000000000000",
                    "status": "accepted",
                    "reference": "RQ-2026-000042",
