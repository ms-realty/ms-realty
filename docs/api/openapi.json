    "/api/inquiries": {
      "get": {
        "operationId": "inquiries.issueSubmissionKey",
        "summary": "Issue a logical submission key for an inquiry form",
        "description": "Returns a server-issued key (256 random bits plus a MAC) and makes sure the browser holds a receipt-session cookie.",
        "tags": ["public_submission"],
        "servers": [
          {
            "url": "https://makler-realty.com",
            "description": "Public host"
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "A fresh submission key",
            "headers": {
              "set-cookie": {
                "description": "Receipt-session cookie, when the browser has none",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submissionKey": {
                      "type": "string"
                    }
                  },
                  "required": ["submissionKey"],
                  "additionalProperties": false
                },
                "example": {
                  "submissionKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA.00000000000000000000000000000000"
                }
              }
            }
          }
        },
        "x-host-context": "public",
        "x-authorization": {
          "class": "public"
        },
        "x-idempotency": "none",
        "x-revision": "none",
        "x-pagination": "none",
        "x-acceptance": ["AT10"]
      },
      "post": {
        "operationId": "inquiries.submit",
        "summary": "Receive one inquiry",
        "description": "One logical submission per key: the same key and payload return the same receipt (200), another payload under the key is refused. JSON clients get the receipt; a form post is answered 303 to the receipt page, or back to the form with only the key and error code.",
        "tags": ["public_submission"],
        "servers": [
          {
            "url": "https://makler-realty.com",
            "description": "Public host"
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "submissionKey": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "question",
                      "callback",
                      "viewing_request",
                      "seller_consultation",
                      "landlord_consultation",
                      "service_consultation"
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": ["bg", "en", "ru", "de", "nl", "el", "he"]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "contact": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["email", "phone"]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 254
                      }
                    },
                    "required": ["kind", "value"]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "listingReference": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "criteria": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "callbackWindow": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "privacyNotice": {
                    "type": "boolean",
                    "const": true
                  },
                  "marketingOptIn": {
                    "default": false,
                    "type": "boolean"
                  },
                  "website": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": ["submissionKey", "purpose", "locale", "contact", "privacyNotice"]
              },
              "example": {
                "submissionKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA.00000000000000000000000000000000",
                "purpose": "question",
                "locale": "bg",
                "contact": {
                  "kind": "email",
                  "value": "visitor@example.test"
                },
                "message": "Is the apartment still offered?",
                "privacyNotice": true
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "submissionKey": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "question",
                      "callback",
                      "viewing_request",
                      "seller_consultation",
                      "landlord_consultation",
                      "service_consultation"
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": ["bg", "en", "ru", "de", "nl", "el", "he"]
                  },
                  "name": {
                    "type": "string"
                  },
                  "contactKind": {
                    "type": "string",
                    "enum": ["email", "phone"]
                  },
                  "contactValue": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "listingReference": {
                    "type": "string"
                  },
                  "callbackWindow": {
                    "type": "string"
                  },
                  "privacyNotice": {
                    "type": "string",
                    "const": "on"
                  },
                  "marketingOptIn": {
                    "type": "string",
                    "const": "on"
                  },
                  "website": {
                    "description": "Honeypot; people leave it empty",
                    "type": "string"
                  }
                },
                "required": [
                  "submissionKey",
                  "purpose",
                  "locale",
                  "contactKind",
                  "contactValue",
                  "privacyNotice"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A retry of an accepted submission: the original receipt (JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "receipt": {
                      "type": "object",
                      "properties": {
                        "receiptId": {
                          "type": "string",
                          "description": "The logical submission key"
                        },
                        "status": {
                          "type": "string",
                          "const": "accepted"
                        },
                        "reference": {
                          "type": "string",
                          "description": "Human reference, e.g. RQ-2026-000042"
                        },
                        "acceptedAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        },
                        "purpose": {
                          "type": "string",
                          "enum": [
                            "question",
                            "callback",
                            "viewing_request",
                            "seller_consultation",
                            "landlord_consultation",
                            "service_consultation"
                          ]
                        },
                        "locale": {
                          "type": "string",
                          "enum": ["bg", "en", "ru", "de", "nl", "el", "he"]
                        },
                        "listingReference": {
                          "type": ["string", "null"]
                        }
                      },
                      "required": [
                        "receiptId",
                        "status",
                        "reference",
                        "acceptedAt",
                        "purpose",
                        "locale",
                        "listingReference"
                      ],
                      "additionalProperties": false
                    },
                    "operationId": {
                      "type": "string"
                    }
                  },
                  "required": ["receipt", "operationId"],
                  "additionalProperties": false
                }
              }
            }
          },
          "201": {
            "description": "Accepted (JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "receipt": {
                      "type": "object",
                      "properties": {
                        "receiptId": {
                          "type": "string",
