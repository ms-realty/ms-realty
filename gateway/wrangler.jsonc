{
  "$schema": "https://unpkg.com/wrangler@4.143.0/config-schema.json",
  "name": "ms-realty-gateway-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Local development configuration only. Release tooling must supply agency-owned bindings.
  "r2_buckets": [{ "binding": "MAP_ASSETS", "bucket_name": "ms-realty-local-map-fixtures" }],
  "vars": { "MAP_RELEASE_ID": "" }
}
