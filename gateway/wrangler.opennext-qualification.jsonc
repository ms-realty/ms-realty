{
  "$schema": "https://unpkg.com/wrangler@4.143.0/config-schema.json",
  "name": "ms-realty-staging",
  "main": "opennext-worker.mjs",
  "account_id": "921d0224dcd595c87b7928d2b3c479d1",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // No routes/DNS are attached by this template. The reviewed staging generator supplies
  // exact staging routes only after Access, existing DNS and separate DB are verified.
  "routes": [],
  "assets": { "directory": "../.open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ms-realty-staging" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ms-realty-staging-media" },
    { "binding": "MAP_ASSETS", "bucket_name": "ms-realty-staging-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ms-realty-staging-opennext-cache" }
  ],
  "vars": {
    "STAGING": "true",
    "NODE_ENV": "production",
    "DATABASE_RUNTIME": "cloudflare",
    "DATABASE_ENGINE_MAJOR": "16",
    "DATABASE_URL": "postgres://hyperdrive.invalid/msr_staging",
    "APP_ORIGIN": "https://staging.makler-realty.com",
    "CANONICAL_ORIGIN": "https://staging.makler-realty.com",
    "PUBLIC_ORIGIN": "https://staging.makler-realty.com",
    "CLIENT_ORIGIN": "https://staging-my.makler-realty.com",
    "STAFF_ORIGIN": "https://staging-app.makler-realty.com",
    "ORIGIN_URL": "https://msr-internal.invalid",
    "MEDIA_PUBLIC_BASE_URL": "https://staging.makler-realty.com/media",
    "MAP_RELEASE_ID": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
