{
  "name": "ms-realty",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:gateway": "node scripts/staging-types.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project 'unit*'",
    "test:integration": "vitest run --project integration",
    "test:release": "node --test scripts/staging*.test.mjs scripts/production*.test.mjs",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "import:legacy": "tsx src/db/import/cli.ts",
    "check": "make check && make e2e",
    "tokens:build": "node scripts/tokens-build.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "openapi:generate": "tsx --conditions=react-server scripts/openapi.mjs",
    "release:schemas": "tsx scripts/release-schemas.mjs",
    "release:evaluate": "tsx scripts/release-evaluate.mjs",
    "recovery:rehearse": "tsx --conditions=react-server scripts/recovery-rehearsal.ts",
    "auth:bootstrap": "tsx --conditions=react-server scripts/bootstrap-staff.ts",
    "tokens:check": "node scripts/tokens-build.mjs --check",
    "test:visual:docker": "bash scripts/visual-docker.sh check",
    "test:visual:docker:update": "bash scripts/visual-docker.sh update",
    "prebuild": "node scripts/map-runtime.mjs",
    "predev": "node scripts/map-runtime.mjs",
    "test:load": "playwright test --config playwright.load.config.ts",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 opennextjs-cloudflare build --config gateway/wrangler.opennext-qualification.jsonc",
    "preview:cloudflare": "opennextjs-cloudflare preview --config gateway/wrangler.opennext-qualification.jsonc",
    "privacy:reapply-synthetic-tail": "tsx --conditions=react-server scripts/privacy-reapply-synthetic-tail.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@internationalized/date": "3.12.4",
    "@protomaps/basemaps": "5.7.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg-boss": "12.38.0",
    "pg-cloudflare": "1.4.1",
    "pmtiles": "4.5.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "svix": "2.9.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.0.8",
    "@biomejs/biome": "2.6.3",
    "@opennextjs/cloudflare": "1.20.14",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "express": {
      "body-parser": "2.4.0"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
