{
  "name": "ms-realty-production",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node production/server.mjs",
    "design:build": "node production/scripts/build-design-assets.mjs && node production/scripts/build-photo-sphere-viewer.mjs",
    "photo-sphere:build": "node production/scripts/build-photo-sphere-viewer.mjs",
    "docker:up": "node production/scripts/local-production.mjs up",
    "docker:hermes:up": "node production/scripts/local-production.mjs hermes:up",
    "docker:seed": "node production/scripts/local-production.mjs seed",
    "docker:status": "node production/scripts/local-production.mjs status",
    "docker:logs": "node production/scripts/local-production.mjs logs",
    "docker:down": "node production/scripts/local-production.mjs down",
    "docker:reset": "node production/scripts/local-production.mjs reset",
    "test": "node --test production/test/*.test.mjs",
    "search:validate": "python3 search/validate_search_imports.py",
    "search:sync": "node production/scripts/run-search-engine-sync.mjs",
    "search:sync:smoke": "node production/scripts/build-search-engine-sync-smoke.mjs",
    "search:query": "node production/scripts/run-search-engine-query.mjs",
    "search:query:smoke": "node production/scripts/build-search-engine-query-smoke.mjs",
    "search:analytics": "node production/scripts/build-search-analytics-report.mjs",
    "migration:build": "node production/scripts/build-migration-records.mjs",
    "migration:compare:test": "python3 -m unittest migration/test_compare_crawl_artifacts.py",
    "migration:db": "python3 migration/build_migration_db.py",
    "routes:build": "node production/scripts/build-route-map.mjs",
    "migration:review": "node production/scripts/build-migration-review-queue.mjs",
    "redirects:preflight": "node production/scripts/validate-redirect-approvals.mjs",
    "redirects:build": "node production/scripts/build-deployable-redirects.mjs",
    "sitemap:build": "node production/scripts/build-localized-sitemap.mjs",
    "seo:build": "node production/scripts/build-seo-files.mjs",
    "structured:data": "node production/scripts/build-structured-data-report.mjs",
    "cms:build": "node production/scripts/build-cms-seed.mjs",
    "listing:quality": "node production/scripts/build-listing-quality-report.mjs",
    "listing:publication": "node production/scripts/build-listing-publication-report.mjs",
    "listing:publication:run": "node production/scripts/run-listing-publication-schedules.mjs",
    "listing:verification": "node production/scripts/build-listing-verification-report.mjs",
    "listing:preflight:report": "node production/scripts/build-listing-quality-preflight-report.mjs",
    "listing:review-pack": "node production/scripts/build-listing-quality-review-packet.mjs",
    "listing:preflight": "node production/scripts/validate-listing-quality-review.mjs",
    "app:routes": "node production/scripts/build-app-route-manifest.mjs",
    "public:build": "node production/scripts/render-public-fixtures.mjs",
    "admin:build": "node production/scripts/build-admin-fixtures.mjs",
    "runtime:build": "node production/scripts/build-runtime-smoke.mjs",
    "http:build": "node production/scripts/build-http-smoke.mjs",
    "translation:coverage": "node production/scripts/build-translation-coverage-report.mjs",
    "locale:rollout": "node production/scripts/build-locale-rollout-report.mjs",
    "hermes:provisioning": "node production/scripts/build-hermes-provider-provisioning-report.mjs",
    "hermes:runtime": "node production/scripts/run-hermes-agent-runtime.mjs",
    "hermes:drafts": "node production/scripts/build-hermes-draft-dispatch.mjs",
    "hermes:worker": "node production/scripts/run-hermes-draft-worker.mjs",
    "hermes:worker:smoke": "node production/scripts/build-hermes-draft-worker-smoke.mjs",
    "lead:sla": "node production/scripts/build-lead-sla-report.mjs",
    "lead:matching": "node production/scripts/build-lead-matching-report.mjs",
    "saved-search:alerts": "node production/scripts/build-saved-search-alert-report.mjs",
    "seo:evidence": "node production/scripts/build-seo-evidence.mjs",
    "seo:preflight:report": "node production/scripts/build-seo-evidence-preflight-report.mjs",
    "seo:preflight": "node production/scripts/validate-seo-evidence-inputs.mjs",
    "live:provisioning": "node production/scripts/build-live-service-provisioning-report.mjs",
    "live:provisioning:preflight": "node production/scripts/validate-live-service-provisioning-report.mjs",
    "live:capture": "node production/scripts/run-live-service-evidence.mjs",
    "live:report": "node production/scripts/build-live-service-preflight-report.mjs",
    "live:preflight": "node production/scripts/validate-live-service-reports.mjs",
    "payload:bootstrap": "node production/scripts/build-payload-runtime-bootstrap.mjs",
    "payload:runtime": "node production/scripts/build-payload-runtime-report.mjs",
    "payload:preflight": "node production/scripts/validate-payload-runtime-report.mjs",
    "server:smoke": "node production/scripts/smoke-node-server.mjs",
    "qa:mobile": "node production/scripts/build-mobile-elderly-qa-report.mjs",
    "launch:readiness": "node production/scripts/build-launch-readiness.mjs",
    "launch:inputs": "node production/scripts/build-launch-input-checklist.mjs",
    "launch:preflight": "node production/scripts/launch-preflight.mjs",
    "next:build": "next build",
    "validate": "npm run design:build && python3 locales/validate_locale_registry.py && python3 search/build_search_indexes.py && npm run search:validate && npm run search:sync:smoke && npm run search:query:smoke && npm run migration:compare:test && npm run migration:build && npm run migration:db && npm run routes:build && npm run migration:review && npm run redirects:build && npm run sitemap:build && npm run seo:build && npm run cms:build && npm run structured:data && npm run listing:quality && npm run listing:publication && npm run listing:verification && npm run listing:preflight:report && npm run listing:review-pack && npm run app:routes && npm run public:build && npm run admin:build && npm run runtime:build && npm run http:build && npm run search:analytics && npm run translation:coverage && npm run locale:rollout && npm run hermes:provisioning && npm run hermes:drafts && npm run hermes:worker:smoke && npm run lead:sla && npm run lead:matching && npm run saved-search:alerts && npm run seo:evidence && npm run seo:preflight:report && npm run live:provisioning && npm run live:report && npm run payload:bootstrap && npm run payload:runtime && npm run server:smoke && npm run qa:mobile && npm run launch:readiness && npm run launch:inputs && node production/scripts/validate-foundation.mjs && python3 qa/mobile_elderly_static_check.py",
    "check": "npm run test && npm run validate && npm run next:build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/translations": "3.85.2",
    "@photo-sphere-viewer/core": "5.14.3",
    "next": "16.2.10",
    "payload": "3.85.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "dompurify": "3.4.11",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "lucide-static": "^1.24.0"
  }
}
