{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The edge no longer injects an admin credential. It used to attach
	# `Authorization: Bearer $MS_REALTY_ADMIN_TOKEN` to every /admin/* request,
	# which made anyone who could reach this port a full admin and recorded
	# every action against one shared operator. Operators now sign in at
	# /admin/login and carry their own session cookie, so the edge is a plain
	# reverse proxy again.
	reverse_proxy app:3000
}
