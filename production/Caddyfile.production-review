{
	admin off
	servers {
		# https://www.cloudflare.com/ips/ — pin the edge ranges so arbitrary
		# clients cannot forge CF-Connecting-IP on the public origin.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(app_proxy) {
	@app_operator path /admin /admin/* /api/admin/*
	reverse_proxy @app_operator app:3000 {
		header_up Authorization "Bearer {$MS_REALTY_ADMIN_TOKEN}"
		header_up CF-Connecting-IP {client_ip}
	}
	reverse_proxy app:3000 {
		header_up CF-Connecting-IP {client_ip}
	}
}

:8080 {
	encode zstd gzip
	route {
		import app_proxy
	}
}

{$MS_REALTY_REVIEW_HOST} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	route {
		@typesense_health {
			method GET
			path /_search/typesense/health
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @typesense_health {
			uri strip_prefix /_search/typesense
			reverse_proxy typesense:8108 {
				header_up X-TYPESENSE-API-KEY "{$TYPESENSE_API_KEY}"
			}
		}

		@typesense_query {
			method GET
			path /_search/typesense/collections/ms_realty_listings/documents/search
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @typesense_query {
			uri strip_prefix /_search/typesense
			reverse_proxy typesense:8108 {
				header_up X-TYPESENSE-API-KEY "{$TYPESENSE_API_KEY}"
			}
		}

		@typesense_sync {
			method POST
			path /_search/typesense/collections /_search/typesense/collections/ms_realty_listings/documents/import
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @typesense_sync {
			uri strip_prefix /_search/typesense
			reverse_proxy typesense:8108 {
				header_up X-TYPESENSE-API-KEY "{$TYPESENSE_API_KEY}"
			}
		}

		@meilisearch_health {
			method GET
			path /_search/meilisearch/health
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @meilisearch_health {
			uri strip_prefix /_search/meilisearch
			reverse_proxy meilisearch:7700 {
				header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			}
		}

		@meilisearch_query {
			method POST
			path /_search/meilisearch/indexes/ms_realty_listings/search
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @meilisearch_query {
			uri strip_prefix /_search/meilisearch
			reverse_proxy meilisearch:7700 {
				header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			}
		}

		@meilisearch_sync {
			method PATCH POST
			path /_search/meilisearch/indexes/ms_realty_listings/settings /_search/meilisearch/indexes/ms_realty_listings/documents
			header X-MS-Realty-Search-Origin-Token {$MS_REALTY_SEARCH_ORIGIN_TOKEN}
		}
		handle @meilisearch_sync {
			uri strip_prefix /_search/meilisearch
			reverse_proxy meilisearch:7700 {
				header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			}
		}

		@search path /_search/*
		respond @search "Not found" 404

		basic_auth {
			{$MS_REALTY_REVIEW_USER} {$MS_REALTY_REVIEW_PASSWORD_HASH}
		}
		@legacy_media path /wp-content/uploads/*
		handle @legacy_media {
			header Cache-Control "public, max-age=31536000, immutable"
			header X-Content-Type-Options "nosniff"
			root * /srv/media
			try_files /makler-realty.com{path} /makler-realty.ru{path}
			file_server
		}
		import app_proxy
	}
}

www.makler-realty.com {
	redir https://makler-realty.com{uri} permanent
}

www.makler-realty.ru {
	redir https://makler-realty.ru{uri} permanent
}

makler-realty.com {
	encode zstd gzip
	route {
		@legacy_media path /wp-content/uploads/*
		handle @legacy_media {
			header Cache-Control "public, max-age=31536000, immutable"
			header X-Content-Type-Options "nosniff"
			root * /srv/media/makler-realty.com
			file_server
		}

		@payload_private path /payload-admin /payload-admin/* /api/admins /api/admins/* /graphql /graphql/* /graphql-playground /graphql-playground/* /api/graphql /api/graphql/*
		respond @payload_private "Not found" 404

		@public_operator path /admin /admin/* /api/admin/*
		basic_auth @public_operator {
			{$MS_REALTY_REVIEW_USER} {$MS_REALTY_REVIEW_PASSWORD_HASH}
		}
		import app_proxy
	}
}

makler-realty.ru {
	encode zstd gzip
	route {
		@legacy_media path /wp-content/uploads/*
		handle @legacy_media {
			header Cache-Control "public, max-age=31536000, immutable"
			header X-Content-Type-Options "nosniff"
			root * /srv/media/makler-realty.ru
			file_server
		}

		@payload_private path /payload-admin /payload-admin/* /api/admins /api/admins/* /graphql /graphql/* /graphql-playground /graphql-playground/* /api/graphql /api/graphql/*
		respond @payload_private "Not found" 404

		@public_operator path /admin /admin/* /api/admin/*
		basic_auth @public_operator {
			{$MS_REALTY_REVIEW_USER} {$MS_REALTY_REVIEW_PASSWORD_HASH}
		}
		import app_proxy
	}
}
