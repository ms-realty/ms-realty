{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "const": "ms-realty"
    },
    "specVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "releaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "string",
      "enum": ["local", "ci", "staging", "production"]
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "web": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "migration": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gateway": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["web", "worker", "migration", "gateway"],
      "additionalProperties": false
    },
    "revisions": {
      "type": "object",
      "properties": {
        "dependencies": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompts": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemas": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["dependencies", "model", "prompts", "schemas"],
      "additionalProperties": false
    },
    "providerAccounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "schemaDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastMigration": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["schemaDigest", "lastMigration"],
      "additionalProperties": false
    },
    "manifests": {
      "type": "object",
      "properties": {
        "domains": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "redirects": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataImport": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["domains", "redirects", "media", "dataImport"],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          }
        }
      },
      "required": ["services", "regions", "locales", "channels"],
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "properties": {
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
        },
        "roles": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retention": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "templates": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["policyRevision", "roles", "retention", "templates"],
      "additionalProperties": false
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{3,128}$"
      }
    },
    "evidenceDigests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{3,128}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["operator", "reviewer"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "scope": {
            "type": "string",
            "const": "release"
          },
          "evidenceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{3,128}$"
          }
        },
        "required": ["role", "name", "approvedAt", "scope", "evidenceId"],
        "additionalProperties": false
      }
    },
    "recoveryPoint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{3,128}$"
            },
            "sealedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": ["id", "sealedAt"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "procedures": {
      "type": "object",
      "properties": {
        "cutover": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": ["ref", "digest"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": ["ref", "digest"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["cutover", "rollback"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "specVersion",
    "releaseSha",
    "environment",
    "artifacts",
    "revisions",
    "providerAccounts",
    "database",
    "manifests",
    "scope",
    "policies",
    "evidenceIds",
    "evidenceDigests",
    "approvals",
    "recoveryPoint",
    "procedures"
  ],
  "additionalProperties": false,
  "$id": "release-manifest.schema.json",
  "title": "ReleaseManifest"
}
