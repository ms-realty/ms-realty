{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms-realty-live-services",
  "main": "workers/live-services-proxy.js",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "workers_dev": true,
  "env": {
    "typesense": {
      "name": "ms-realty-typesense",
      "vars": {
        "MS_REALTY_SEARCH_ENGINE": "typesense",
        "MS_REALTY_SEARCH_TARGET": "ms_realty_listings"
      }
    },
    "meilisearch": {
      "name": "ms-realty-meilisearch",
      "vars": {
        "MS_REALTY_SEARCH_ENGINE": "meilisearch",
        "MS_REALTY_SEARCH_TARGET": "ms_realty_listings"
      }
    }
  }
}
